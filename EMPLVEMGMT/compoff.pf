A               R COMPREC                   TEXT('COMPOFF REQUEST RECORD')
A                 COMID          8S 0        COLHDG('COMOFF ID')
A                 COMEMPID       4S 0       COLHDG('EMP ID')
A                 COMWRDT        8S 0       COLHDG('WORKED DATE')
A                 COMDYTY        2A         COLHDG('DAY TYPE')
A                                            VALUES('FH' 'SH' 'FD')
A                 COMRSN       100A         COLHDG('REASON')
A                 COMSTS         1A         COLHDG('STATUS')
A                                            VALUES('A' 'D' 'P' 'C')
A                 COMPRJD        6A         COLHDG('PROJECT ID')
A                                            VALUES('EL' 'CL' 'CO')
A               K COMID
A               K COMEMPID
