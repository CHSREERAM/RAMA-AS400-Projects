     A                                      COLOR(WHT)
     A                                  7  8'Date'
     A                                      COLOR(WHT)
     A                                  7 19'Reason'
     A                                      COLOR(WHT)
     A                                  7 41'DayType'
     A                                      COLOR(WHT)
