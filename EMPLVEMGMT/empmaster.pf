A               R EMPREC                    TEXT('EMPLOYEE MASTER RECORD')
A                 EMPID          4S 0       COLHDG('EMPLOYEE ID')
A                 EMPNAM        30A         COLHDG('EMPLOYEE NAME')
A                 EMPADR1       50A         COLHDG('ADDRESS LINE1')
A                 EMPADR2       50A         COLHDG('ADDRESS LINE2')
A                 EMPPC          6S 0       COLHDG('PIN CODE')
A                 EMPCITY       20A         COLHDG('CITY')
A                 EMPCTRY       20A         COLHDG('COUNTRY')
A                 EMPCON        10S 0       COLHDG('CONTACT NO')
A                 EMPEMG        10S 0       COLHDG('EMERGENCY CONTACT NO')
A                 EMPGND         1A         COLHDG('GENDER')
A                 EMPDOB         8S 0       COLHDG('DATE OF BIRTH')
A                 EMPDOJ         8S 0       COLHDG('DATE OF JOINING')
A                 EMPEMLP       30A         COLHDG('PERSONAL EMAIL')
A                 EMPEMLO       30A         COLHDG('OFFICE EMAIL')
A                 EMPTEAM       10A         COLHDG('TEAM')
A                 EMPPRJID       6A         COLHDG('PROJECT ID')
A                 EMPMGRID       4S 0       COLHDG('MANGER ID')
A                 EMPROL         1A         COLHDG('ROLE')
A                 EMPDES        20A         COLHDG('DESIGNATION')
A                 EMPSTS         1A         COLHDG('WORKING STATUS')
A               K EMPID
