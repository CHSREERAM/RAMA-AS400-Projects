A               R LEAVEREC                   TEXT('LEAVE REQUEST RECORD FORMAT')
A                 LVEID          8S 0        COLHDG('LEAVE ID')
A                 LVEEMPID       4S 0       COLHDG('EMP ID')
A                 LVEFRDT        8S 0       COLHDG('FROM DATE')
A                 LVEFRDY        2A         COLHDG('FROM DATE TYPE')
A                                            VALUES('FH' 'SH' 'FD')
A                 LVETODT        8S 0       COLHDG('TO DATE')
A                 LVETODY        2A         COLHDG('TO DATE TYPE')
A                                            VALUES('FH' 'SH' 'FD')
A                 LVETDAY        2S 0       COLHDG('TOTAL DAYS')
A                 LVERSNY      100A         COLHDG('REASON')
A                 LVESTS         1A         COLHDG('STATUS')
A                                            VALUES('A' 'D' 'P' 'C')
A                 LVECLTY        2A         COLHDG('LEAVE TYPE')
A                                            VALUES('EL' 'CL' 'CO')
A               K LVEEMPID
