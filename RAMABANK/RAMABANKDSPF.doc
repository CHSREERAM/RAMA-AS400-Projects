     A*%%***********************************************************************
     A*%% RAMA BANK - OTP VERIFICATION POPUP
     A*%% New screen for OTPVERPGM, which previously had no display file at
     A*%% all and unconditionally returned "valid" without checking anything.
     A*%%***********************************************************************
     A                                      DSPSIZ(24 80 *DS3)
     A                                      CA03(03 'CANCEL')
     A                                      INDARA
     A          R OTPFMT
     A                                      WINDOW(8 6 8 70)
     A                                  1  3'OTP VERIFICATION'
     A                                      DSPATR(HI)
     A                                  3  3'An OTP has been sent to your'+
     A                                       ' registered mobile number.'
     A                                  5  3'Enter OTP:'
     A            OTPINP         6A  B  5 15DSPATR(ND)
     A            OTPERR        40A  O  6  3COLOR(RED)
     A                                  7  3'F3=Cancel   Enter=Submit'
     A                                      COLOR(BLU)
     A*%%***********************************************************************
     A*%% RAMA BANK - PROFILE AND CHANGE PASSWORD
     A*%%***********************************************************************
     A                                      DSPSIZ(24 80 *DS3)
     A                                      CA03(03 'EXIT')
     A                                      INDARA
     A*=======================================================================
     A          R PROFFMT
     A                                  1 25'MY PROFILE & KYC'
     A                                      DSPATR(HI)
     A                                  4  5'Customer ID:'
     A            CUSTID        20A  O  4 18
     A                                  5  5'Name.......:'
     A            NAME          40A  O  5 18
     A                                  7  5'PAN........:'
     A            PAN           10A  O  7 18
     A                                  8  5'Aadhaar....:'
     A            AADHAAR       12A  O  8 18
     A                                 10  5'Mobile.....:'
     A            MOBILE        15A  O 10 18
     A                                 11  5'Email......:'
     A            EMAIL         50A  O 11 18
     A                                 13  5'Address....:'
     A            ADDRESS      100A  O 13 18
     A                                 16  5'Update Request Field:'
     A            UPDFLD        10A  B 16 27
     A                                 17  5'New Value...........:'
     A            UPDVAL        50A  B 17 27
     A            ERRMSG        40A  O 19  5COLOR(RED)
     A                                 23  2'F3=Exit   Enter=Request Value+
     A                                       Update'
     A                                      COLOR(BLU)
     A*=======================================================================
     A          R CHGPWD
     A                                  1 25'CHANGE PASSWORD'
     A                                      DSPATR(HI)
     A                                  4  5'For security, password must have+
     A                                       uppercase, lowercase, digit, spec+
     A                                       char.'
     A                                  6  5'Current Password.:'
     A            CURPWD        20A  B  6 24DSPATR(ND)
     A                                  8  5'New Password.....:'
     A            NEWPWD        20A  B  8 24DSPATR(ND)
     A                                 10  5'Confirm Password.:'
     A            CNFPWD        20A  B 10 24DSPATR(ND)
     A            PWDERR        40A  O 12  5COLOR(RED)
     A                                 23  2'F3=Exit   Enter=Change Password'
     A                                      COLOR(BLU)

     A                                      DSPSIZ(24 80 *DS3)
     A                                      INDARA
     A          R RESETFMT
     A                                      CA03(03 'Exit')
     A                                  1 25'RAMA BANK - RESET PASSWORD'
     A                                      DSPATR(HI)
     A                                  4  5'User ID . . . . :'
     A            USERID        20A  B  4 25
     A                                  6  5'New Password  . :'
     A            NEWPWD        20A  B  6 25DSPATR(ND)
     A                                  8  5'Confirm Password:'
     A            CNFPWD        20A  B  8 25DSPATR(ND)
     A            ERRMSG        50A  O 20  5DSPATR(HI) COLOR(RED)
     A                                 23  5'F3=Cancel and Return to Login'
     A*%%TS  SD  20260705  191809  SREERAMC    REL-V7R5M0  5770-WDS
     A*%%EC
     A*%%***********************************************************************
     A*%% RAMA BANK - STATEMENT SCREEN WITH COLOR CODING
     A*%%***********************************************************************
     A                                      DSPSIZ(24 80 *DS3)
     A                                      CA03(03 'EXIT')
     A                                      CA06(06 'PRINT')
     A                                      CA07(07 'PAGE UP')
     A                                      CA08(08 'PAGE DOWN')
     A                                      INDARA
     A          R STMTSFL                   SFL
     A            $TXNDATE      10A  O  8  2
     A            $TXNTIME       8A  O  8 13
     A            $REFNUM       20A  O  8 22
     A            $TYPE          2A  O  8 43
     A            $AMOUNT       15A  O  8 47
     A  50                                  COLOR(RED)
     A  51                                  COLOR(GRN)
     A            $BALAFTER     13Y 2O  8 64EDTCDE(4)
     A*
     A          R STMTCTL                   SFLCTL(STMTSFL)
     A*%%TS  SD  20260705  191809  SREERAMC    REL-V7R5M0  5770-WDS
     A                                      OVERLAY
     A  40                                  SFLDSP
     A  41                                  SFLDSPCTL
     A  42                                  SFLCLR
     A  43                                  SFLEND(*MORE)
     A                                      SFLSIZ(0100)
     A                                      SFLPAG(0010)
     A                                  1 25'ACCOUNT STATEMENT'
     A                                      DSPATR(HI)
     A                                  3  2'Account:'
     A            $ACCTNUM      20A  O  3 12
     A                                  3 40'From Date:'
     A            $FRMDATE      10A  B  3 51
     A                                  4 40'To Date..:'
     A            $TODATE       10A  B  4 51
     A                                  5  2'Filter Type (DR/CR/ALL):'
     A            $FLTTYPE       3A  B  5 27
     A            $ERRMSG       40A  O  5 40COLOR(RED)
     A                                  6  2'-----------------------------------
     A                                      -'
     A                                  7  2'Date'
     A                                  7 13'Time'
     A                                  7 22'Reference'
     A                                  7 42'Cr/Dr'
     A                                  7 51'Amount'
     A                                  7 69'Balance'
     A*
     A          R STMTFTR
     A*%%TS  SD  20260705  191809  SREERAMC    REL-V7R5M0  5770-WDS
     A                                      OVERLAY
     A                                 23  2'F3=Exit   F6=Print Statement  F7=Pag-
     A                                      eUp   F8=PageDown'
     A                                      COLOR(BLU)
