/*====================================================================*/
/* RAMA BANK - COMPLETE COMPILE ORDER FOR SREERAMC1                  */
/* Run each step in sequence. A failure in any step will cascade     */
/* compile errors to dependent objects if skipped.                   */
/*====================================================================*/

/* ============================================================       */
/* STEP 0: SQL SEQUENCES (Run via STRSQL or ACS Run SQL Scripts)     */
/* ============================================================       */
/* RUNSQLSTM SRCFILE(SREERAMC1/QSQLSRC) SRCMBR(CRTSEQ)              */
/* (Copy the content of SQL/CRTSEQ.SQL into QSQLSRC member CRTSEQ)  */


/* ============================================================       */
/* STEP 1: PHYSICAL FILES (must compile before anything else)         */
/* ============================================================       */
CRTPF FILE(SREERAMC1/USERMST)    SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/CUSTMST)    SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/ACCTMST)    SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/TXNHIST)    SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/BENEFMST)   SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/CARDMST)    SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/CRDLIMIT)   SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/AUDITLOG)   SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/BILLERMST)  SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/BILLREG)    SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/EMISCHDULE) SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/IFSCLOOKUP) SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/NOMINEEMST) SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/PWDHIST)    SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/TXNQUEUE)   SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/UPDATEREQ)  SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
/* New PFs added in this build: */
CRTPF FILE(SREERAMC1/LOANMST)    SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/FDMST)      SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/OTPSTORE)   SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)


/* ============================================================       */
/* STEP 2: LOGICAL FILES (must follow their PFILE)                    */
/* ============================================================       */
CRTLF FILE(SREERAMC1/ACCTMSTL1)  SRCFILE(SREERAMC1/QDDSSRC)
CRTLF FILE(SREERAMC1/TXNHISTL1)  SRCFILE(SREERAMC1/QDDSSRC)


/* ============================================================       */
/* STEP 3: DISPLAY FILES                                              */
/* ============================================================       */
CRTDSPF FILE(SREERAMC1/LOGINSCR)    SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/RESETSCR)    SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/DASHSCR)     SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/ACCTDTLSCR)  SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/STMTSCR)     SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/MINISCR)     SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/FUNDSCR)     SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/BENEFSCR)    SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/BILLPAYSCR)  SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/CARDDTLSCR)  SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/CHGPWDSCR)   SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/LOANDTLSCR)  SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/FDSCR)       SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/PROFSCR)     SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/ADMINSCR)    SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/OTPSCR)      SRCFILE(SREERAMC1/QDDSSRC)


/* ============================================================       */
/* STEP 4: SERVICE PROGRAMS (compile as *MODULE then CRTSRVPGM)      */
/* ============================================================       */
/* 4a. Compile HASHSRV module */
CRTSQLRPGI OBJ(SREERAMC1/HASHSRV) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*MODULE) DBGVIEW(*SOURCE)

/* 4b. Compile OTPSRV module */
CRTSQLRPGI OBJ(SREERAMC1/OTPSRV) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*MODULE) DBGVIEW(*SOURCE)

/* 4c. Compile SETPINPGM module (NoMain service module) */
CRTSQLRPGI OBJ(SREERAMC1/SETPINPGM) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*MODULE) DBGVIEW(*SOURCE)

/* 4d. Create the binding directory */
CRTBNDDIR  BNDDIR(SREERAMC1/RAMABND)
ADDBNDDIRE BNDDIR(SREERAMC1/RAMABND) OBJ((SREERAMC1/HASHSRV *MODULE) +
              (SREERAMC1/OTPSRV *MODULE) +
              (SREERAMC1/SETPINPGM *MODULE))

/* 4e. Create the service program binding all modules together */
CRTSRVPGM  SRVPGM(SREERAMC1/RAMASRV) +
           MODULE(SREERAMC1/HASHSRV SREERAMC1/OTPSRV +
                  SREERAMC1/SETPINPGM) +
           EXPORT(*ALL) BNDDIR(SREERAMC1/RAMABND)

/* Add the service program itself to the binding directory */
ADDBNDDIRE BNDDIR(SREERAMC1/RAMABND) OBJ((SREERAMC1/RAMASRV *SRVPGM))


/* ============================================================       */
/* STEP 5: RPGLE/SQLRPGLE PROGRAMS                                    */
/* (Each bound to RAMABND so they can resolve HASHSRV/OTPSRV/etc.)   */
/* ============================================================       */
CRTSQLRPGI OBJ(SREERAMC1/LOGINPGM)  SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/RESETPGM)  SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/CHGPWDPGM) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/OTPVERPGM) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/DASHPGM)   SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/ACCTDTLPGM) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/STMTPGM)   SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/STMTPRT)   SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/MINIPGM)   SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/FUNDTRPGM) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/NEFTPGM)   SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/BENEFPGM)  SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/BENEFCOOL) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/BILLPAYPGM) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/CARDDTLPGM) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/FDDTLPGM)  SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/LOANDTLPGM) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/PROFILEPGM) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/ADMINPGM)  SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)


/* ============================================================       */
/* STEP 6: CL PROGRAMS                                                */
/* ============================================================       */
CRTCLPGM   PGM(SREERAMC1/SESSCTL)     SRCFILE(SREERAMC1/QCLSRC)
CRTCLPGM   PGM(SREERAMC1/SESTIMCL)    SRCFILE(SREERAMC1/QCLSRC)
CRTCLPGM   PGM(SREERAMC1/LOGOUTCL)    SRCFILE(SREERAMC1/QCLSRC)
CRTCLPGM   PGM(SREERAMC1/CARDCTLCL)   SRCFILE(SREERAMC1/QCLSRC)
CRTCLPGM   PGM(SREERAMC1/AUTOPAYCTL)  SRCFILE(SREERAMC1/QCLSRC)
CRTCLPGM   PGM(SREERAMC1/NEFTBATCH)   SRCFILE(SREERAMC1/QCLSRC)
CRTCLPGM   PGM(SREERAMC1/RPTCTLCL)    SRCFILE(SREERAMC1/QCLSRC)
CRTCLPGM   PGM(SREERAMC1/BENEFCOOLCL) SRCFILE(SREERAMC1/QCLSRC)


/* ============================================================       */
/* STEP 7: JOB SCHEDULER ENTRIES (run once manually)                  */
/* ============================================================       */
/* AutoPay - every night at 23:30 */
/* ADDJOBSCDE JOB(RMAAUTOPY) CMD(CALL SREERAMC1/AUTOPAYCTL)          */
/*   FRQ(*WEEKLY) SCDDATE(*ALL) SCDTIME('23:30:00')                  */

/* Beneficiary cooling - every 5 minutes */
/* ADDJOBSCDE JOB(RMABENEF) CMD(CALL SREERAMC1/BENEFCOOLCL)          */
/*   FRQ(*INTERVAL) INTVL(5)                                          */

/* NEFT/RTGS settlement - every 30 minutes */
/* ADDJOBSCDE JOB(RAMANEFT) CMD(CALL SREERAMC1/NEFTBATCH)            */
/*   FRQ(*INTERVAL) INTVL(30)                                         */
