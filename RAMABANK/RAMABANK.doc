/*====================================================================*/
/* RAMA BANK - COMPLETE COMPILE ORDER FOR SREERAMC1                  */
/* Run each step in sequence. A failure in any step will cascade     */
/* compile errors to dependent objects if skipped.                   */
/*====================================================================*/

/* ============================================================       */
/* STEP 0: SQL SEQUENCES (Run via STRSQL or ACS Run SQL Scripts)     */
/* ============================================================       */
/* RUNSQLSTM SRCFILE(SREERAMC1/QSQLSRC) SRCMBR(CRTSEQ)              */
/* (Copy the content of SQL/CRTSEQ.SQL into QSQLSRC member CRTSEQ)  */


/* ============================================================       */
/* STEP 1: PHYSICAL FILES (must compile before anything else)         */
/* ============================================================       */
CRTPF FILE(SREERAMC1/USERMST)    SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/CUSTMST)    SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/ACCTMST)    SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/TXNHIST)    SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/BENEFMST)   SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/CARDMST)    SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/CRDLIMIT)   SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/AUDITLOG)   SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/BILLERMST)  SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/BILLREG)    SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/EMISCHDULE) SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/IFSCLOOKUP) SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/NOMINEEMST) SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/PWDHIST)    SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/TXNQUEUE)   SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/UPDATEREQ)  SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
/* New PFs added in this build: */
CRTPF FILE(SREERAMC1/LOANMST)    SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/FDMST)      SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)
CRTPF FILE(SREERAMC1/OTPSTORE)   SRCFILE(SREERAMC1/QDDSSRC) MAXMBRS(*NOMAX)


/* ============================================================       */
/* STEP 2: LOGICAL FILES (must follow their PFILE)                    */
/* ============================================================       */
CRTLF FILE(SREERAMC1/ACCTMSTL1)  SRCFILE(SREERAMC1/QDDSSRC)
CRTLF FILE(SREERAMC1/TXNHISTL1)  SRCFILE(SREERAMC1/QDDSSRC)


/* ============================================================       */
/* STEP 3: DISPLAY FILES                                              */
/* ============================================================       */
CRTDSPF FILE(SREERAMC1/LOGINSCR)    SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/RESETSCR)    SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/DASHSCR)     SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/ACCTDTLSCR)  SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/STMTSCR)     SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/MINISCR)     SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/FUNDSCR)     SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/BENEFSCR)    SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/BILLPAYSCR)  SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/CARDDTLSCR)  SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/CHGPWDSCR)   SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/LOANDTLSCR)  SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/FDSCR)       SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/PROFSCR)     SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/ADMINSCR)    SRCFILE(SREERAMC1/QDDSSRC)
CRTDSPF FILE(SREERAMC1/OTPSCR)      SRCFILE(SREERAMC1/QDDSSRC)


/* ============================================================       */
/* STEP 4: SERVICE PROGRAMS (compile as *MODULE then CRTSRVPGM)      */
/* ============================================================       */
/* 4a. Compile HASHSRV module */
CRTSQLRPGI OBJ(SREERAMC1/HASHSRV) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*MODULE) DBGVIEW(*SOURCE)

/* 4b. Compile OTPSRV module */
CRTSQLRPGI OBJ(SREERAMC1/OTPSRV) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*MODULE) DBGVIEW(*SOURCE)

/* 4c. Compile SETPINPGM module (NoMain service module) */
CRTSQLRPGI OBJ(SREERAMC1/SETPINPGM) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*MODULE) DBGVIEW(*SOURCE)

/* 4d. Create the binding directory */
CRTBNDDIR  BNDDIR(SREERAMC1/RAMABND)
ADDBNDDIRE BNDDIR(SREERAMC1/RAMABND) OBJ((SREERAMC1/HASHSRV *MODULE) +
              (SREERAMC1/OTPSRV *MODULE) +
              (SREERAMC1/SETPINPGM *MODULE))

/* 4e. Create the service program binding all modules together */
CRTSRVPGM  SRVPGM(SREERAMC1/RAMASRV) +
           MODULE(SREERAMC1/HASHSRV SREERAMC1/OTPSRV +
                  SREERAMC1/SETPINPGM) +
           EXPORT(*ALL) BNDDIR(SREERAMC1/RAMABND)

/* Add the service program itself to the binding directory */
ADDBNDDIRE BNDDIR(SREERAMC1/RAMABND) OBJ((SREERAMC1/RAMASRV *SRVPGM))


/* ============================================================       */
/* STEP 5: RPGLE/SQLRPGLE PROGRAMS                                    */
/* (Each bound to RAMABND so they can resolve HASHSRV/OTPSRV/etc.)   */
/* ============================================================       */
CRTSQLRPGI OBJ(SREERAMC1/LOGINPGM)  SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/RESETPGM)  SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/CHGPWDPGM) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/OTPVERPGM) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/DASHPGM)   SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/ACCTDTLPGM) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/STMTPGM)   SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/STMTPRT)   SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/MINIPGM)   SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/FUNDTRPGM) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/NEFTPGM)   SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/BENEFPGM)  SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/BENEFCOOL) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/BILLPAYPGM) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/CARDDTLPGM) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/FDDTLPGM)  SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/LOANDTLPGM) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/PROFILEPGM) SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)

CRTSQLRPGI OBJ(SREERAMC1/ADMINPGM)  SRCFILE(SREERAMC1/QRPGLESRC) +
           OBJTYPE(*PGM) BNDDIR(SREERAMC1/RAMABND) DBGVIEW(*SOURCE)


/* ============================================================       */
/* STEP 6: CL PROGRAMS                                                */
/* ============================================================       */
CRTCLPGM   PGM(SREERAMC1/SESSCTL)     SRCFILE(SREERAMC1/QCLSRC)
CRTCLPGM   PGM(SREERAMC1/SESTIMCL)    SRCFILE(SREERAMC1/QCLSRC)
CRTCLPGM   PGM(SREERAMC1/LOGOUTCL)    SRCFILE(SREERAMC1/QCLSRC)
CRTCLPGM   PGM(SREERAMC1/CARDCTLCL)   SRCFILE(SREERAMC1/QCLSRC)
CRTCLPGM   PGM(SREERAMC1/AUTOPAYCTL)  SRCFILE(SREERAMC1/QCLSRC)
CRTCLPGM   PGM(SREERAMC1/NEFTBATCH)   SRCFILE(SREERAMC1/QCLSRC)
CRTCLPGM   PGM(SREERAMC1/RPTCTLCL)    SRCFILE(SREERAMC1/QCLSRC)
CRTCLPGM   PGM(SREERAMC1/BENEFCOOLCL) SRCFILE(SREERAMC1/QCLSRC)


/* ============================================================       */
/* STEP 7: JOB SCHEDULER ENTRIES (run once manually)                  */
/* ============================================================       */
/* AutoPay - every night at 23:30 */
/* ADDJOBSCDE JOB(RMAAUTOPY) CMD(CALL SREERAMC1/AUTOPAYCTL)          */
/*   FRQ(*WEEKLY) SCDDATE(*ALL) SCDTIME('23:30:00')                  */

/* Beneficiary cooling - every 5 minutes */
/* ADDJOBSCDE JOB(RMABENEF) CMD(CALL SREERAMC1/BENEFCOOLCL)          */
/*   FRQ(*INTERVAL) INTVL(5)                                          */

/* NEFT/RTGS settlement - every 30 minutes */
/* ADDJOBSCDE JOB(RAMANEFT) CMD(CALL SREERAMC1/NEFTBATCH)            */
/*   FRQ(*INTERVAL) INTVL(30)                                         */
/*====================================================================*/
/* RAMA BANK - AUTOPAY OVERNIGHT BATCH CONTROLLER                     */
/* Calls BILLPAYPGM with *AUTOPAY mode to settle all AutoPay=Y        */
/* registrations. Intended to be submitted via job scheduler every    */
/* night at 23:30 (configured externally in WRKJOBSCDE).             */
/*                                                                    */
/* Fix vs original: BANKLIB replaced with SREERAMC1.                 */
/*====================================================================*/
             PGM

             DCL        VAR(&CUSTID)  TYPE(*CHAR) LEN(20)
             DCL        VAR(&ERRFLAG) TYPE(*LGL)  VALUE('0')

             CHGVAR     VAR(&CUSTID)  VALUE('*AUTOPAY')

             MONMSG     MSGID(CPF0000) EXEC(DO)
                CHGVAR  VAR(&ERRFLAG) VALUE('1')
                GOTO    CMDLBL(ERROUT)
             ENDDO

             CALL       PGM(SREERAMC1/BILLPAYPGM) PARM(&CUSTID)

             GOTO       CMDLBL(ENDPGM)

 ERROUT:
             SNDPGMMSG  MSG('AUTOPAYCTL: AutoPay batch failed') +
                           TOPGMQ(*SAME)

 ENDPGM:
             ENDPGM
/*====================================================================*/
/* RAMA BANK - BENEFICIARY COOLING PERIOD SCHEDULER                  */
/* New CL controller. Submits BENEFCOOL every 5 minutes to promote   */
/* beneficiaries from STATUS='P' to STATUS='A' once 30 minutes have  */
/* elapsed since their addition. Without this, no beneficiary can     */
/* ever be used in a fund transfer (FUNDTRPGM requires STATUS='A').  */
/* Set up as a scheduler entry: ADDJOBSCDE JOB(RMABENEF)             */
/*   CMD(CALL SREERAMC1/BENEFCOOLCL) FRQ(*INTERVAL) INTVL(5)        */
/*====================================================================*/
             PGM

             MONMSG     MSGID(CPF0000) EXEC(DO)
                SNDPGMMSG  MSG('BENEFCOOLCL: Cooling batch error') +
                              TOPGMQ(*SAME)
                RETURN
             ENDDO

             SBMJOB     CMD(CALL PGM(SREERAMC1/BENEFCOOL)) +
                           JOBQ(QBATCH) +
                           JOBNAME(RMABENCO) +
                           USER(QSYS)

             ENDPGM
/*====================================================================*/
/* RAMA BANK - CARD CONTROL DISPATCHER                                */
/* Receives card number and action from CARDDTLPGM, dispatches to     */
/* appropriate service. SETPINPGM now called as a standalone *PGM     */
/* (with Main), not as a bound module, since it has a PEP and is      */
/* compiled as a program object in SREERAMC1.                         */
/*                                                                    */
/* Fixes vs original:                                                 */
/*  - BANKLIB replaced with SREERAMC1 throughout.                     */
/*  - Third parameter (NEWPIN) removed; PIN is now generated          */
/*    internally by SETPINPGM rather than passed in from the screen.  */
/*  - CARD STATUS update call had no WHERE clause in the original     */
/*    (was truncated). Now uses RUNSQL for targeted SQL.              */
/*====================================================================*/
             PGM        PARM(&CARDNUM &ACTION)
             DCL        VAR(&CARDNUM) TYPE(*CHAR) LEN(16)
             DCL        VAR(&ACTION)  TYPE(*CHAR) LEN(10)
             DCL        VAR(&SQLSTMT) TYPE(*CHAR) LEN(200)
             DCL        VAR(&ERRFLAG) TYPE(*LGL)  VALUE('0')

             MONMSG     MSGID(CPF0000) EXEC(DO)
                CHGVAR  VAR(&ERRFLAG) VALUE('1')
                GOTO    CMDLBL(ERROUT)
             ENDDO

             IF         COND(&ACTION *EQ '*BLOCK') THEN(DO)
                RUNSQL     SQL('UPDATE SREERAMC1.CARDMST +
                                SET STATUS = ''B'' +
                                WHERE CARDNUM = ''' *TCAT &CARDNUM *TCAT +
                                '''') COMMIT(*NONE)
             ENDDO

             IF         COND(&ACTION *EQ '*UNBLOCK') THEN(DO)
                RUNSQL     SQL('UPDATE SREERAMC1.CARDMST +
                                SET STATUS = ''A'' +
                                WHERE CARDNUM = ''' *TCAT &CARDNUM *TCAT +
                                '''') COMMIT(*NONE)
             ENDDO

             IF         COND(&ACTION *EQ '*HOTLIST') THEN(DO)
                RUNSQL     SQL('UPDATE SREERAMC1.CARDMST +
                                SET STATUS = ''H'' +
                                WHERE CARDNUM = ''' *TCAT &CARDNUM *TCAT +
                                '''') COMMIT(*NONE)
             ENDDO

             IF         COND(&ACTION *EQ '*UPDATEPIN') THEN(DO)
                CALL       PGM(SREERAMC1/SETPINPGM) PARM(&CARDNUM)
             ENDDO

             GOTO       CMDLBL(ENDPGM)

 ERROUT:
             SNDPGMMSG  MSG('CARDCTLCL: error processing +
                            card action') TOPGMQ(*SAME)

 ENDPGM:
             ENDPGM
/*====================================================================*/
/* RAMA BANK - LOGOUT / SESSION TERMINATION                           */
/* Clears the session data area in QTEMP and clears SESSIONID from   */
/* USERMST so the token cannot be reused after logout.               */
/*                                                                    */
/* Fix vs original: BANKLIB replaced with SREERAMC1.                 */
/*====================================================================*/
             PGM

             DCL        VAR(&SESDATA)   TYPE(*CHAR) LEN(70)
             DCL        VAR(&USERID)    TYPE(*CHAR) LEN(20)
             DCL        VAR(&ERRFLAG)   TYPE(*LGL)  VALUE('0')

             MONMSG     MSGID(CPF0000) EXEC(DO)
                CHGVAR  VAR(&ERRFLAG) VALUE('1')
                GOTO    CMDLBL(ERROUT)
             ENDDO

             /* Read USERID from the session data area */
             RTVDTAARA  DTAARA(QTEMP/RAMASES) RTNVAR(&SESDATA)
             MONMSG     MSGID(CPF1015) /* not found - job already clean */

             CHGVAR     VAR(&USERID) VALUE(%SST(&SESDATA 1 20))

             /* Invalidate session token in USERMST */
             RUNSQL     SQL('UPDATE SREERAMC1.USERMST +
                             SET SESSIONID = NULL +
                             WHERE USERID = ''' *TCAT %TRIM(&USERID) +
                             *TCAT '''') COMMIT(*NONE)

             /* Delete the session data area */
             DLTDTAARA  DTAARA(QTEMP/RAMASES)
             MONMSG     MSGID(CPF1015) /* not found is fine */

             GOTO       CMDLBL(ENDPGM)

 ERROUT:
             SNDPGMMSG  MSG('LOGOUTCL: Session cleanup error') +
                           TOPGMQ(*SAME)

 ENDPGM:
             ENDPGM
/*====================================================================*/
/* RAMA BANK - NEFT/RTGS BATCH SETTLEMENT SCHEDULER                  */
/* Submits NEFTPGM every 30 minutes via SBMJOB to process pending     */
/* TXNQUEUE rows (STATUS='P') created by FUNDTRPGM for interbank      */
/* transfers. Run via STRJOBQ / job scheduler entry.                 */
/*                                                                    */
/* Fix vs original:                                                   */
/*  - BANKLIB replaced with SREERAMC1.                                */
/*  - Original called BANKLIB/NEFTPGM which never existed. NEFTPGM   */
/*    has now been created in SREERAMC1 as part of this production    */
/*    build.                                                          */
/*====================================================================*/
             PGM

             DCL        VAR(&ERRFLAG) TYPE(*LGL) VALUE('0')

             MONMSG     MSGID(CPF0000) EXEC(DO)
                CHGVAR  VAR(&ERRFLAG) VALUE('1')
                GOTO    CMDLBL(ERROUT)
             ENDDO

             SBMJOB     CMD(CALL PGM(SREERAMC1/NEFTPGM)) +
                           JOBQ(QBATCH) +
                           JOBNAME(RAMANEFT) +
                           USER(QSYS)

             GOTO       CMDLBL(ENDPGM)

 ERROUT:
             SNDPGMMSG  MSG('NEFTBATCH: Failed to submit NEFTPGM') +
                           TOPGMQ(*SAME)

 ENDPGM:
             ENDPGM
/*====================================================================*/
/* RAMA BANK - REPORT BATCH CONTROLLER                                */
/* Submits the RPTPGM report program (not yet built - placeholder)   */
/* to QBATCH. Called from ADMINPGM option 4 (or directly via         */
/* SBMJOB from a scheduler entry).                                   */
/*                                                                    */
/* Fix vs original:                                                   */
/*  - BANKLIB replaced with SREERAMC1.                                */
/*  - Hardcoded date '2026-02-22' replaced with CURRENT DATE (via    */
/*    SQL scalar in the CMD parameter).                               */
/*  - RPTPGM still does not exist in this codebase. The SBMJOB will  */
/*    fail at runtime until RPTPGM is developed. This is clearly      */
/*    marked here.                                                    */
/*====================================================================*/
             PGM

             MONMSG     MSGID(CPF0000) EXEC(DO)
                SNDPGMMSG  MSG('RPTCTLCL: Failed to submit batch report') +
                              TOPGMQ(*SAME)
                RETURN
             ENDDO

             /* NOTE: SREERAMC1/RPTPGM does not yet exist.            */
             /* Remove this comment and the MONMSG above once RPTPGM  */
             /* is developed and compiled into SREERAMC1.              */
             SBMJOB     CMD(CALL PGM(SREERAMC1/RPTPGM)) +
                           JOBQ(QBATCH) +
                           JOBNAME(RAMARPT) +
                           USER(QSYS)

             ENDPGM
/*====================================================================*/
/* RAMA BANK - SESSION CONTROL                                        */
/* Receives UserID and SessionID from LOGINPGM. Stores the session    */
/* token in QTEMP/SESSION data area for downstream use.              */
/* SESTIMCL sets a session timeout via SBMJOB after this runs.       */
/*                                                                    */
/* Fix vs original: BANKLIB replaced with SREERAMC1 throughout.      */
/*====================================================================*/
             PGM        PARM(&USERID &SESSIONID)

             DCL        VAR(&USERID)    TYPE(*CHAR) LEN(20)
             DCL        VAR(&SESSIONID) TYPE(*CHAR) LEN(50)
             DCL        VAR(&ERRFLAG)   TYPE(*LGL)  VALUE('0')

             MONMSG     MSGID(CPF0000) EXEC(DO)
                CHGVAR  VAR(&ERRFLAG) VALUE('1')
                GOTO    CMDLBL(ERROUT)
             ENDDO

             /* Store session context in QTEMP for the job's lifetime */
             CRTDTAARA  DTAARA(QTEMP/RAMASES) TYPE(*CHAR) LEN(70) +
                           VALUE(' ')
             MONMSG     MSGID(CPF1023) /* already exists - ignore */

             CHGDTAARA  DTAARA(QTEMP/RAMASES) VALUE(&USERID *TCAT +
                           *BLANK *TCAT &SESSIONID)

             /* Start session timeout monitor */
             SBMJOB     CMD(CALL PGM(SREERAMC1/SESTIMCL) +
                              PARM(&USERID &SESSIONID)) +
                           JOBQ(QBATCH) JOBNAME(RMASESTO) USER(QSYS)

             GOTO       CMDLBL(ENDPGM)

 ERROUT:
             SNDPGMMSG  MSG('SESSCTL: session creation failed') +
                           TOPGMQ(*SAME)

 ENDPGM:
             ENDPGM
/*====================================================================*/
/* RAMA BANK - SESSION TIMEOUT MONITOR                                */
/* Submitted as a background SBMJOB by SESSCTL. Waits 15 minutes     */
/* then invalidates the session in USERMST if still active.          */
/*====================================================================*/
             PGM        PARM(&USERID &SESSIONID)

             DCL        VAR(&USERID)    TYPE(*CHAR) LEN(20)
             DCL        VAR(&SESSIONID) TYPE(*CHAR) LEN(50)

             MONMSG     MSGID(CPF0000)

             /* Wait 15 minutes (900 seconds) then invalidate */
             DLYJOB     DLY(900)

             RUNSQL     SQL('UPDATE SREERAMC1.USERMST +
                             SET SESSIONID = NULL +
                             WHERE USERID = ''' *TCAT %TRIM(&USERID) +
                             *TCAT ''' AND SESSIONID = ''' +
                             *TCAT %TRIM(&SESSIONID) *TCAT +
                             '''') COMMIT(*NONE)

             ENDPGM
     A*%%TS  SD  20260626  133608  SREERAMC    REL-V7R5M0  5770-WDS
     A*%%EC
     A*%%***********************************************************************
     A*%% RAMA BANK - ACCOUNT DETAILS SCREEN
     A*%%***********************************************************************
     A                                      DSPSIZ(24 80 *DS3)
     A                                      CA03(03 'EXIT')
     A                                      CA04(04 'TOGGLE MASK')
     A                                      INDARA
     A          R ACCTFMT
     A                                  1 25'ACCOUNT DETAILS'
     A                                      DSPATR(HI)
     A                                  4  5'Customer ID...:'
     A            $CUSTID       20A  O  4 22
     A                                  5  5'Customer Name.:'
     A            $CUSTNAME     40A  O  5 22
     A                                  7  5'Account Number:'
     A            $ACCTNUM      20A  O  7 22DSPATR(HI)
     A                                  8  5'Branch........:'
     A            $BRANCH       50A  O  8 22
     A                                  9  5'IFSC..........:'
     A            $IFSC         11A  O  9 22
     A                                 10  5'MICR Code.....:'
     A            $MICR          9A  O 10 22
     A                                 12  5'Current Bal...:'
     A            $BALANCE      15Y 2O 12 22EDTCDE(4) COLOR(GRN)
     A                                 14  5'Nominee Name..:'
     A            $NOMNAME      40A  O 14 22
